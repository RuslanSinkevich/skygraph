# Dependencies
node_modules/

# Lockfiles — pnpm only (npm/yarn lockfiles are atavisms here)
package-lock.json
yarn.lock

# Build outputs
dist/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Env / local
.env
.env.*
!.env.example
*.local

# Test / coverage
coverage/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo

# Vite (demo)
examples/demo/dist/

# Local static site bundle (regenerate with `node deploy/build-all.mjs`)
deploy/output/

# Local scratch (commit message bodies for HEREDOC-style commits, etc.)
.git-commit-msg.tmp
*.tmp

# Playwright (T-Smoke)
playwright-report/
test-results/
.playwright/

# Visual audit screenshots — generated locally by `scripts/audit-*.mjs`.
# Re-run the scripts to regenerate; they never belong in commits.
screenshots/

# api-extractor working dir (T-API). Snapshots live in `etc/`, are committed.
packages/*/temp/

# Angular CLI / ng-packagr work directories
examples/demo-angular/.angular/
examples/demo-angular/dist/
packages/angular/dist/
