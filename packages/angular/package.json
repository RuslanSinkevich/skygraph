{
  "name": "@skygraph/angular",
  "version": "0.0.1",
  "description": "SkyGraph Angular adapter — components, directives, services and DI tokens",
  "license": "MIT",
  "private": true,
  "type": "module",
  "module": "./dist/fesm2022/skygraph-angular.mjs",
  "typings": "./dist/types/skygraph-angular.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./dist/types/skygraph-angular.d.ts",
      "default": "./dist/fesm2022/skygraph-angular.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skygraph/skygraph.git",
    "directory": "packages/angular"
  },
  "keywords": [
    "angular",
    "ui",
    "components",
    "design-system",
    "skygraph"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@skygraph/styles": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@skygraph/core": ">=0.1.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.20.1",
    "@analogjs/vitest-angular": "^2.5.0",
    "@angular-devkit/architect": "^0.2102.10",
    "@angular-devkit/schematics": "^21.2.10",
    "@angular/common": "^21.2.12",
    "@angular/compiler": "^21.2.12",
    "@angular/compiler-cli": "^21.2.12",
    "@angular/core": "^21.2.12",
    "@angular/platform-browser": "^21.2.12",
    "@skygraph/core": "workspace:*",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.0",
    "ng-packagr": "^21.2.3",
    "rimraf": "^5.0.0",
    "rxjs": "^7.8.1",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9",
    "zone.js": "~0.16.2"
  }
}
