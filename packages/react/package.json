{
  "name": "@skygraph/react",
  "version": "0.1.0",
  "description": "SkyGraph React adapter — hooks, components and UI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./styles": "./styles/index.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./styles/themes/dark.css": "./styles/themes/dark.css",
    "./styles/components/*": "./styles/components/*"
  },
  "files": ["dist", "styles"],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "@skygraph/core": ">=0.1.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@skygraph/core": "file:../core",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "jsdom": "^25.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0",
    "rimraf": "^5.0.0"
  }
}
