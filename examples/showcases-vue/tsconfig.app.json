{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "noEmit": true,
    "skipLibCheck": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@skygraph/core": ["../../packages/core/src/index.ts"],
      "@skygraph/vue": ["../../packages/vue/src/index.ts"],
      "@skygraph/styles": ["../../packages/styles/index.d.ts"],
      "@skygraph-examples/shared": ["../_shared/src/index.ts"],
      "@skygraph-examples/shared-vue": ["../_shared-vue/src/index.ts"],
      "@skygraph-examples/shared-vue/layout": ["../_shared-vue/src/layout/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../_shared-vue/src/**/*.ts",
    "../_shared-vue/src/**/*.vue"
  ]
}
