{
  "name": "skygraph",
  "private": true,
  "type": "module",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "eslint packages/",
    "lint:examples": "eslint --config examples-eslint.config.js examples/demo/src examples/showcases/src",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,json}\"",
    "clean": "pnpm -r clean",
    "audit:styles": "node scripts/audit-styles.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:no-important": "node scripts/check-no-important.mjs",
    "check:styles": "pnpm run check:tokens && pnpm run check:no-important"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.0.0",
    "prettier": "^3.8.2",
    "typescript-eslint": "^8.58.1"
  }
}
