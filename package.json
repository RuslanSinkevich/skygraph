{
  "name": "skygraph",
  "private": true,
  "type": "module",
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.14",
      "@types/react-dom": "^19.2.3"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint packages/",
    "lint:examples": "eslint --config examples-eslint.config.js examples/demo/src examples/showcases/src",
    "format": "prettier --write \"packages/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,css,json}\"",
    "clean": "pnpm -r clean",
    "audit:styles": "node scripts/audit-styles.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:no-important": "node scripts/check-no-important.mjs",
    "check:styles": "pnpm run check:tokens && pnpm run check:no-important",
    "prepare": "husky",
    "prepare:hooks": "husky",
    "api:check": "pnpm -r --if-present run api:check",
    "api:update": "pnpm -r --if-present run api:update",
    "size": "size-limit",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "test:smoke": "playwright test --config=playwright.config.ts",
    "test:smoke:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@microsoft/api-extractor": "^7.47.0",
    "@playwright/test": "^1.48.0",
    "@size-limit/preset-app": "^11.1.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.8.2",
    "size-limit": "^11.1.0",
    "typescript-eslint": "^8.58.1"
  }
}
